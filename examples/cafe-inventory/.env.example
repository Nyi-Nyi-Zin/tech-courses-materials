# Local development. Set your own URL before starting the app.
DATABASE_URL=postgresql://cafe:replace-with-local-db-password@127.0.0.1:5432/cafe_inventory
APP_ORIGIN=http://localhost:5173
PORT=3000

# Tests need a separate database, such as cafe_inventory_test.
# CAFE_TEST_DATABASE_URL=postgresql://cafe:replace-with-local-db-password@127.0.0.1:5432/cafe_inventory_test

# Use a migration role here in deployment, if separate from the API role.
# MIGRATION_DATABASE_URL=postgresql://cafe_migrator:password@db-host:5432/cafe_inventory
